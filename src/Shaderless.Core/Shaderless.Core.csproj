<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Shaderless.Core</AssemblyName>
    <RootNamespace>Shaderless.Core</RootNamespace>
    <Product>Shaderless</Product>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.3.0-beta</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Shaderless.Tests" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\upstream\Shaderless.Engine\Shaderless.Engine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Native\shaderless_warm.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Native\d3d12.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Native\dxgi.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
